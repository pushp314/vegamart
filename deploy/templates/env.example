# ==============================================================================
# VegaMart Unified Production Environment
# ==============================================================================

# ── Application Configuration ──────────────────────────────────────────────────
NODE_ENV=production
APP_NAME=Vegamart
APP_PORT=8080
API_VERSION=v1

# Domains (Replace with your actual domains)
VEGAMART_DOMAIN=example.com

# URL Configuration
APP_URL=https://api.example.com
CLIENT_URL=https://example.com
VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_APP_NAME=Vegamart
VITE_APP_ENV=production

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Note: DATABASE_URL is automatically generated and populated by the deploy script.
DATABASE_URL=""
POSTGRES_PASSWORD=""

# ── Redis ──────────────────────────────────────────────────────────────────────
# Note: REDIS_URL is automatically generated and populated by the deploy script.
REDIS_URL=""
REDIS_PASSWORD=""

# ── Security & JWT (MUST CHANGE) ───────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_replace_me
JWT_REFRESH_SECRET=your_super_secret_refresh_key_replace_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=Vegamart
JWT_AUDIENCE=Vegamart

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# ── Application Features ───────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
EMAIL_VERIFICATION_REQUIRED=false
VERIFY_EMAIL_TOKEN_TTL_HOURS=24
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=40

# ── External Services ──────────────────────────────────────────────────────────
# Razorpay (Requires configuration)
RAZORPAY_KEY_ID=placeholder
RAZORPAY_KEY_SECRET=placeholder
RAZORPAY_WEBHOOK_SECRET=placeholder
VITE_RAZORPAY_KEY_ID=

# Cloudflare R2 / AWS S3 (Requires configuration)
R2_ACCOUNT_ID=placeholder
R2_ACCESS_KEY_ID=placeholder
R2_SECRET_ACCESS_KEY=placeholder
R2_BUCKET_NAME=vegamart
R2_PUBLIC_URL=https://cdn.example.com

# Email (SMTP) (Requires configuration)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="VegaMart <no-reply@example.com>"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/api/v1/auth/google/callback
