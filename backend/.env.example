# ==============================================================================
# Gali Connect Backend — Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in your environment specific values.
# NEVER commit `.env` to version control.
# ==============================================================================

# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=Vegamart
APP_PORT=8080
APP_URL=http://localhost:8080
API_VERSION=v1
CLIENT_URL=http://localhost:3000

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gali_connect?schema=public

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=Vegamart
JWT_AUDIENCE=Vegamart

# ── Cookies ────────────────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── Account Security ───────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
EMAIL_VERIFICATION_REQUIRED=false
VERIFY_EMAIL_TOKEN_TTL_HOURS=24

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

# ── Redis (optional; set REDIS_URL to enable caching) ──────────────────────────
REDIS_URL=

# ── Cloudflare R2 ──────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Razorpay ───────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Nodemailer / SMTP) ──────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Gali Connect <no-reply@galiconnect.local>

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# ── Swagger ────────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
