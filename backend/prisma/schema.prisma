  expires_at               DateTime?
  auto_renew               Boolean   @default(true)
  razorpay_subscription_id String?   @unique @db.VarChar(64)
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  vendor   VendorProfile         @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  plan     VendorMembershipPlan  @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  history  SubscriptionHistory[]
  payments SubscriptionPayment[]

  @@index([status])
  @@index([expires_at])
  @@map("vendor_subscriptions")
}

model SubscriptionHistory {
  id               String   @id @default(uuid()) @db.Uuid
  subscription_id  String   @db.Uuid
  action           String   @db.VarChar(50) // created, upgraded, downgraded, renewed, canceled
  previous_plan_id String?  @db.Uuid
  new_plan_id      String?  @db.Uuid
  created_at       DateTime @default(now())

  subscription VendorSubscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([subscription_id])
  @@map("subscription_history")
}

model SubscriptionPayment {
  id                       String   @id @default(uuid()) @db.Uuid
  subscription_id          String   @db.Uuid
  amount                   Decimal  @db.Decimal(10, 2)
  currency                 String   @default("INR") @db.VarChar(10)
  status                   String   @default("pending") @db.VarChar(50) // pending, paid, failed, refunded
  payment_method           String?  @db.VarChar(50)
  transaction_id           String?  @db.VarChar(100)
  razorpay_subscription_id String?  @unique @db.VarChar(64)
  razorpay_payment_id      String?  @unique @db.VarChar(64)
  razorpay_signature       String?  @db.VarChar(255)
  gateway_response         Json?    @db.JsonB
  failed_reason            String?  @db.VarChar(255)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  subscription VendorSubscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([subscription_id])
  @@map("subscription_payments")
}

model Promotion {
  id          String   @id @default(uuid()) @db.Uuid
  vendor_id   String   @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  banner_url  String?  @db.VarChar(255)
  discount    Decimal  @db.Decimal(10, 2)
  starts_at   DateTime
  ends_at     DateTime
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  vendor VendorProfile @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@index([vendor_id])
  @@index([is_active, starts_at, ends_at])
  @@map("promotions")
}

model StoreAnalytics {
  id            String   @id @default(uuid()) @db.Uuid
  vendor_id     String   @db.Uuid
  date          DateTime @db.Date
  store_views   Int      @default(0)
  total_revenue Decimal  @default(0) @db.Decimal(10, 2)
  total_orders  Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  vendor VendorProfile @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([vendor_id, date])
  @@map("store_analytics")
}

model ProductAnalytics {
  id         String   @id @default(uuid()) @db.Uuid
  product_id String   @db.Uuid
  date       DateTime @db.Date
  views      Int      @default(0)
  sales      Int      @default(0)
  revenue    Decimal  @default(0) @db.Decimal(10, 2)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, date])
  @@map("product_analytics")
}

model CustomerAnalytics {
  id               String   @id @default(uuid()) @db.Uuid
  vendor_id        String   @db.Uuid
  date             DateTime @db.Date
  new_customers    Int      @default(0)
  repeat_customers Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  vendor VendorProfile @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([vendor_id, date])
  @@map("customer_analytics")
}

model DailyOrderCounter {
  id         String   @id @default(uuid()) @db.Uuid
  vendor_id  String   @db.Uuid
  date       DateTime @db.Date
  count      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  vendor VendorProfile @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([vendor_id, date])
  @@map("daily_order_counters")
}

model SystemSetting {
  id                 String   @id @map("id") @db.Uuid
  maintenanceEnabled Boolean  @default(false) @map("maintenance_enabled")
  maintenanceMessage String?  @map("maintenance_message")
  updatedBy          String?  @map("updated_by")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("system_settings")
}

model MaintenanceAuditLog {
  id          String   @id @default(uuid()) @map("id") @db.Uuid
  action      String   @map("action")
  developerId String?  @map("developer_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  message     String?  @map("message")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@map("maintenance_audit_logs")
}

model UserSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  vendor_id  String   @db.Uuid
  created_at DateTime @default(now())

  user   User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vendor VendorProfile @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([user_id, vendor_id])
}
