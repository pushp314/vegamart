// Payments & Ledger
// ──────────────────────────────────────────────────────────────────────────────

model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  order_id            String        @unique @db.Uuid
  razorpay_order_id   String?       @unique @db.VarChar(64)
  razorpay_payment_id String?       @unique @db.VarChar(64)
  razorpay_signature  String?       @db.VarChar(255)
  method              PaymentMethod @default(RAZORPAY)
  amount              Decimal       @db.Decimal(10, 2)
  status              PaymentStatus @default(PENDING)
  currency            String        @default("INR") @db.VarChar(10)
  attempts            Int           @default(0)
  failure_reason      String?       @db.VarChar(255)
  refund_id           String?       @db.VarChar(64)
  refund_amount       Decimal?      @db.Decimal(10, 2)
  refund_status       String?       @db.VarChar(40)
  gateway_response    Json?         @db.JsonB
  webhook_events      Json?         @db.JsonB
  idempotency_key     String?       @unique @db.VarChar(120)
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  order        Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([razorpay_order_id])
  @@index([status])
  @@index([created_at])
  @@map("payments")
}

model Transaction {
  id         String          @id @default(uuid()) @db.Uuid
  order_id   String          @db.Uuid
  payment_id String          @db.Uuid
  user_id    String?         @db.Uuid
  type       TransactionType @default(DEBIT)
  amount     Decimal         @db.Decimal(10, 2)
  currency   String          @default("INR") @db.VarChar(10)
  status     String          @db.VarChar(40)
  reference  String?         @db.VarChar(120)
  metadata   Json?           @db.JsonB
  created_at DateTime        @default(now())

  order   Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([payment_id])
  @@index([user_id])
  @@index([created_at])
  @@map("transactions")
}

model VendorEarning {
  id         String         @id @default(uuid()) @db.Uuid
  vendor_id  String         @db.Uuid
  order_id   String         @db.Uuid
  type       EarningsType   @default(ORDER_COMMISSION)
  amount     Decimal        @db.Decimal(10, 2)
  status     EarningsStatus @default(PENDING)
  settled_at DateTime?
  // Ties an earning (e.g. a REFUND reversal) to the source event such as a
  // payment/refund id. Null for initial order earnings. Enforced unique per order
  // so a replayed refund callback can never double-create its reversal row.
  reference_id String? @db.VarChar(120)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  vendor VendorProfile @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  order  Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@unique([order_id, reference_id])
  @@index([vendor_id, status])
  @@index([order_id])
  @@map("vendor_earnings")
}

model DeliveryEarning {
  id                  String         @id @default(uuid()) @db.Uuid
  delivery_partner_id String         @db.Uuid
  order_id            String         @db.Uuid
  type                EarningsType   @default(DELIVERY_FEE)
  amount              Decimal        @db.Decimal(10, 2)
  status              EarningsStatus @default(PENDING)
  settled_at          DateTime?
  reference_id        String?        @db.VarChar(120)
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  delivery_partner DeliveryProfile @relation(fields: [delivery_partner_id], references: [id], onDelete: Cascade)
  order            Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@unique([order_id, reference_id])
  @@index([delivery_partner_id, status])
  @@index([order_id])
  @@map("delivery_earnings")
}

