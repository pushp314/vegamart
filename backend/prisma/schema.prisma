// ==============================================================================
// Gali Connect — Prisma Schema (PostgreSQL)
// ==============================================================================
// Hyperlocal marketplace: Customers, Street Vendors, Delivery Partners, Admins.
// Conventions:
//   * UUID primary keys (server-side default generated by PostgreSQL)
//   * snake_case columns and fields (matches the React frontend contracts)
//   * Soft deletes via `deleted_at` on business entities
//   * `created_at` / `updated_at` on every table
//   * PostGIS-friendly `lat` / `lng` DoublePrecision columns
//   * Money stored as Decimal(10,2)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER         @map("customer")
  VENDOR           @map("vendor")
  DELIVERY_PARTNER @map("delivery")
  ADMIN            @map("admin")
  SUPER_ADMIN      @map("super_admin")
}

enum UserStatus {
  ACTIVE    @map("active")
  INACTIVE  @map("inactive")
  SUSPENDED @map("suspended")
  BANNED    @map("banned")
}

enum VendorStatus {
  PENDING   @map("pending")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  SUSPENDED @map("suspended")
}

enum DeliveryStatus {
  PENDING   @map("pending")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  SUSPENDED @map("suspended")
}

enum KycStatus {
  NOT_SUBMITTED @map("not_submitted")
  PENDING       @map("pending")
  VERIFIED      @map("verified")
  REJECTED      @map("rejected")
}

enum OrderStatus {
  PENDING          @map("pending")
  CONFIRMED        @map("confirmed")
  PREPARING        @map("preparing")
  PACKED           @map("packed")
  READY_FOR_PICKUP @map("ready_for_pickup")
  PICKED_UP        @map("picked_up")
  OUT_FOR_DELIVERY @map("out_for_delivery")
  DELIVERED        @map("delivered")
  CANCELLED        @map("cancelled")
  REFUNDED         @map("refunded")
  RETURNED         @map("returned")
  FAILED           @map("failed")
}

enum PaymentStatus {
  PENDING            @map("pending")
  INITIATED          @map("initiated")
  PAID               @map("paid")
  FAILED             @map("failed")
  REFUNDED           @map("refunded")
  PARTIALLY_REFUNDED @map("partially_refunded")
}

enum PaymentMethod {
  RAZORPAY @map("razorpay")
  COD      @map("cod")
  WALLET   @map("wallet")
}

enum TransactionType {
  CREDIT @map("credit")
  DEBIT  @map("debit")
}

enum CouponType {
  PERCENTAGE    @map("percentage")
  FIXED         @map("fixed")
  FREE_DELIVERY @map("free_delivery")
}

enum NotificationChannel {
  EMAIL  @map("email")
  SMS    @map("sms")
  PUSH   @map("push")
  IN_APP @map("in_app")
}

enum NotificationType {
  ORDER       @map("order")
  PAYMENT     @map("payment")
  PROMOTIONAL @map("promotional")
  SYSTEM      @map("system")
  DELIVERY    @map("delivery")
  VENDOR      @map("vendor")
}

enum OtpPurpose {
  EMAIL_VERIFICATION @map("email_verification")
  PHONE_VERIFICATION @map("phone_verification")
  PASSWORD_RESET     @map("password_reset")
  LOGIN              @map("login")
}

enum TicketStatus {
  OPEN        @map("open")
  IN_PROGRESS @map("in_progress")
  RESOLVED    @map("resolved")
  CLOSED      @map("closed")
}

enum TicketPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
  URGENT @map("urgent")
}

enum BroadcastType {
  ROAMING @map("roaming")
  SHOP    @map("shop")
}

enum AvailabilityStatus {
  ONLINE      @map("online")
  OFFLINE     @map("offline")
  BUSY        @map("busy")
  ON_DELIVERY @map("on_delivery")
}

enum EarningsType {
  ORDER_COMMISSION @map("order_commission")
  DELIVERY_FEE     @map("delivery_fee")
  TIP              @map("tip")
  BONUS            @map("bonus")
  REFUND           @map("refund")
  WITHDRAWAL       @map("withdrawal")
}

enum EarningsStatus {
  PENDING @map("pending")
  SETTLED @map("settled")
  FAILED  @map("failed")
}

// ──────────────────────────────────────────────────────────────────────────────
// Identity & Access
// ──────────────────────────────────────────────────────────────────────────────

model User {
  id                    String     @id @default(uuid()) @db.Uuid
  role_id               String     @db.Uuid
  name                  String     @db.VarChar(120)
  email                 String     @unique @db.VarChar(255)
  phone                 String?    @unique @db.VarChar(20)
  password_hash         String     @db.VarChar(255)
  password_history      Json?      @db.JsonB
  password_changed_at   DateTime?
  avatar_url            String?    @db.VarChar(500)
  status                UserStatus @default(ACTIVE)
  is_verified           Boolean    @default(false)
  email_verified_at     DateTime?
  phone_verified_at     DateTime?
  last_login_at         DateTime?
  failed_login_attempts Int        @default(0)
  locked_until          DateTime?
  two_factor_enabled    Boolean    @default(false)
  provider              String?    @db.VarChar(50) // "local" | "google" | "apple"
  provider_id           String?    @db.VarChar(255)
  created_at            DateTime   @default(now())
  updated_at            DateTime   @updatedAt
  deleted_at            DateTime?

  role                  Role                  @relation(fields: [role_id], references: [id], onDelete: Restrict)
  vendor_profile        VendorProfile?
  delivery_profile      DeliveryProfile?
  addresses             Address[]
  refresh_tokens        RefreshToken[]
  sessions              Session[]
  otps                  OtpVerification[]
  password_reset_tokens PasswordResetToken[]
  notifications         Notification[]
  orders                Order[]               @relation("CustomerOrders")
  checkout_idempotencies CheckoutIdempotency[]
  cart                  Cart?
  wishlist_items        WishlistItem[]
  coupon_usages         CouponUsage[]
  reviews               Review[]
  audit_logs            AuditLog[]
  support_tickets       SupportTicket[]
  kyc_records           KycRecord[]
  recent_views          RecentlyViewed[]
  favorite_vendors      CustomerFavorite[]
  vendor_follows        VendorFollower[]
  nearby_search_history NearbySearchHistory[]
  vendor_reviews        VendorReview[]
  userSubscriptions     UserSubscription[]

  @@index([email])
  @@index([phone])
  @@index([role_id])
  @@index([status])
  @@index([deleted_at])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  slug        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users            User[]
  role_permissions RolePermission[]
  permissions      Permission[]     @relation("RolePermissions")

  @@index([slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  slug        String   @unique @db.VarChar(120)
  group       String?  @db.VarChar(80)
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  roles           Role[]           @relation("RolePermissions")
  rolePermissions RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  id            String   @id @default(uuid()) @db.Uuid
  role_id       String   @db.Uuid
  permission_id String   @db.Uuid
  created_at    DateTime @default(now())

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([permission_id])
  @@map("role_permissions")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  token_hash  String    @unique @db.VarChar(255)
  session_id  String?   @db.Uuid
  expires_at  DateTime
  revoked_at  DateTime?
  replaced_by String?   @db.Uuid
  ip_address  String?   @db.VarChar(45)
  user_agent  String?   @db.VarChar(500)
  created_at  DateTime  @default(now())

  user    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [session_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  user_id          String    @db.Uuid
  device_name      String?   @db.VarChar(120)
  device_type      String?   @db.VarChar(30)
  ip_address       String?   @db.VarChar(45)
  user_agent       String?   @db.VarChar(500)
  is_active        Boolean   @default(true)
  last_activity_at DateTime  @default(now())
  expires_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refresh_tokens RefreshToken[]

  @@index([user_id])
  @@index([is_active])
  @@map("sessions")
}

model OtpVerification {
  id         String     @id @default(uuid()) @db.Uuid
  identifier String     @db.VarChar(255) // email or phone
  otp_hash   String     @db.VarChar(255)
  purpose    OtpPurpose
  expires_at DateTime
  attempts   Int        @default(0)
  is_used    Boolean    @default(false)
  used_at    DateTime?
  ip_address String?    @db.VarChar(45)
  created_at DateTime   @default(now())
  user       User?      @relation(fields: [userId], references: [id])
  userId     String?    @db.Uuid

  @@index([identifier, purpose])
  @@index([expires_at])
  @@map("otp_verifications")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime
  is_used    Boolean   @default(false)
  used_at    DateTime?
  ip_address String?   @db.VarChar(45)
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

// ──────────────────────────────────────────────────────────────────────────────
// Marketplace Core
// ──────────────────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  parent_id   String?   @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  icon        String?   @db.VarChar(500)
  color       String?   @db.VarChar(30)
  image_url   String?   @db.VarChar(500)
  sort_order  Int       @default(0)
  is_active   Boolean   @default(true)
  is_featured Boolean   @default(false)
  commission_rate Decimal? @db.Decimal(5, 2)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  parent   Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parent_id])
  @@index([slug])
  @@index([is_active])
  @@map("categories")
}

model VendorProfile {
  id                      String       @id @default(uuid()) @db.Uuid
  user_id                 String       @unique @db.Uuid
  business_name           String       @db.VarChar(160)
  slug                    String       @unique @db.VarChar(180)
  description             String?      @db.Text
  category                String?      @db.VarChar(120)
  tags                    String?      @db.VarChar(300)
  logo_url                String?      @db.VarChar(500)
  banner_url              String?      @db.VarChar(500)
  address                 String       @db.VarChar(300)
  landmark                String?      @db.VarChar(200)
  city                    String       @db.VarChar(100)
  state                   String       @db.VarChar(100)
  country                 String       @default("India") @db.VarChar(60)
  pincode                 String       @db.VarChar(10)
  latitude                Float?       @db.DoublePrecision
  longitude               Float?       @db.DoublePrecision
  delivery_radius_km      Float        @default(5)
  business_hours          String?      @db.VarChar(100)
  min_order               Decimal      @default(0) @db.Decimal(10, 2)
  delivery_fee            Decimal      @default(0) @db.Decimal(10, 2)
  advance_payment_percentage Decimal @default(10) @db.Decimal(5, 2)
  free_delivery_min_order Decimal?     @db.Decimal(10, 2)
  provides_delivery       Boolean      @default(false)
  delivery_options        String[]     @default([])
  delivery_configs        Json?        @default("{}")
  estimated_delivery_time String?      @default("20-30 mins") @db.VarChar(50)
  tax_rate                Decimal?     @db.Decimal(5, 2)
  banner_urls             String[]     @default([])
  rating                  Float        @default(0) @db.DoublePrecision
  review_count            Int          @default(0)
  is_open                 Boolean      @default(false)
  is_verified             Boolean      @default(false)
  is_sponsored            Boolean      @default(false)
  sponsored_until         DateTime?
  sponsored_priority      Int          @default(0)
  status                  VendorStatus @default(PENDING)
  owner_name              String?      @db.VarChar(120)
  phone                   String?      @db.VarChar(20)
  rejection_reason        String?      @db.Text
  commission_rate         Decimal      @default(5) @db.Decimal(5, 2)
  membership_tier         String       @default("basic") @db.VarChar(50)
  membership_plan_id      String?      @db.Uuid
  membership_expires_at   DateTime?
  available_from          String?      @db.VarChar(20)
  available_to            String?      @db.VarChar(20)
  roaming                 Boolean      @default(false)
  bank_account_number     String?      @db.VarChar(50)
  bank_ifsc               String?      @db.VarChar(20)
  bank_account_holder_name String?     @db.VarChar(160)
  bank_name               String?      @db.VarChar(100)
  upi_id                  String?      @db.VarChar(100)
  razorpay_account_id     String?      @db.VarChar(100)
  payout_enabled          Boolean      @default(true)
  created_at              DateTime     @default(now())
  updated_at              DateTime     @updatedAt
  deleted_at              DateTime?

  user               User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  membership_plan    VendorMembershipPlan?   @relation(fields: [membership_plan_id], references: [id], onDelete: SetNull)
  products           Product[]
  orders             Order[]
  broadcasts         Broadcast[]
  vendor_earnings    VendorEarning[]
  daily_locations    VendorDailyLocation[]
  location_history   VendorLocationHistory[]
  favorited_by       CustomerFavorite[]
  vendor_reviews     VendorReview[]
  followers          VendorFollower[]
  subscription       VendorSubscription?
  promotions         Promotion[]
  store_analytics    StoreAnalytics[]
  customer_analytics CustomerAnalytics[]
  daily_orders       DailyOrderCounter[]
  created_coupons    Coupon[]                @relation("VendorCoupons")
  userSubscriptions  UserSubscription[]

  @@index([user_id])
  @@index([slug])
  @@index([status])
  @@index([city, state])
  @@index([is_open])
  @@index([membership_plan_id])
  @@map("vendor_profiles")
}

model VendorMembershipPlan {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @db.VarChar(80)
  slug                 String   @unique @db.VarChar(80)
  description          String?  @db.Text
  price                Decimal  @default(0) @db.Decimal(10, 2)
  billing_period       String   @default("monthly") @db.VarChar(20)
  features             Json     @default("[]")
  product_limit        Int      @default(20)
  daily_order_limit    Int      @default(5)
  commission_rate      Decimal  @default(5) @db.Decimal(5, 2)
  includes_sponsorship Boolean  @default(false)
  is_active            Boolean  @default(true)
  sort_order           Int      @default(0)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  vendors       VendorProfile[]
  subscriptions VendorSubscription[]

  @@index([is_active])
  @@map("vendor_membership_plans")
}

model VendorDailyLocation {
  id             String   @id @default(uuid()) @db.Uuid
  vendor_id      String   @db.Uuid
  broadcast_date DateTime @db.Date
  area           String   @db.VarChar(200)
  landmark       String?  @db.VarChar(200)
  address        String   @db.VarChar(400)
  latitude       Float    @db.DoublePrecision
  longitude      Float    @db.DoublePrecision
  start_time     String?  @db.VarChar(10)
  end_time       String?  @db.VarChar(10)
  notes          String?  @db.VarChar(500)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  vendor VendorProfile @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([vendor_id, broadcast_date])
  @@index([broadcast_date])
  @@index([latitude, longitude])
  @@index([is_active, broadcast_date])
  @@map("vendor_daily_locations")
}

model VendorLocationHistory {
  id          String   @id @default(uuid()) @db.Uuid
  vendor_id   String   @db.Uuid
  area        String   @db.VarChar(200)
  landmark    String?  @db.VarChar(200)
  address     String   @db.VarChar(400)
  latitude    Float    @db.DoublePrecision
  longitude   Float    @db.DoublePrecision
  start_time  String?  @db.VarChar(10)
  end_time    String?  @db.VarChar(10)
  notes       String?  @db.VarChar(500)
  is_active   Boolean  @default(true)
  recorded_at DateTime @default(now())
  created_at  DateTime @default(now())

  vendor VendorProfile @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@index([vendor_id, recorded_at])
  @@index([latitude, longitude])
  @@map("vendor_location_history")
}

// ──────────────────────────────────────────────────────────────────────────────
// Discovery — Favorites, Follows & Nearby Search History
// ──────────────────────────────────────────────────────────────────────────────

model CustomerFavorite {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  vendor_id  String   @db.Uuid
  created_at DateTime @default(now())

  user   User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vendor VendorProfile @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([user_id, vendor_id])
  @@index([vendor_id])
  @@map("customer_favorites")
}

model VendorFollower {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  vendor_id  String   @db.Uuid
  created_at DateTime @default(now())

  user   User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vendor VendorProfile @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([user_id, vendor_id])
  @@index([vendor_id])
  @@map("vendor_followers")
}

model NearbySearchHistory {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  query      String   @db.VarChar(200)
  category   String?  @db.VarChar(120)
  latitude   Float    @db.DoublePrecision
  longitude  Float    @db.DoublePrecision
  radius_km  Float    @default(5) @db.DoublePrecision
  filters    Json?    @db.JsonB
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("nearby_search_history")
}

model DeliveryProfile {
  id                  String             @id @default(uuid()) @db.Uuid
  user_id             String             @unique @db.Uuid
  vehicle_type        String             @db.VarChar(60)
  vehicle_number      String             @db.VarChar(30)
  license_number      String             @db.VarChar(60)
  status              DeliveryStatus     @default(PENDING)
  is_verified         Boolean            @default(false)
  is_available        Boolean            @default(false)
  base_delivery_fee   Decimal            @default(0) @db.Decimal(10, 2)
  fee_per_km          Decimal            @default(0) @db.Decimal(10, 2)
  availability_status AvailabilityStatus @default(OFFLINE)
  current_lat         Float?             @db.DoublePrecision
  current_lng         Float?             @db.DoublePrecision
  rating              Float              @default(0) @db.DoublePrecision
  review_count        Int                @default(0)
  rejection_reason    String?            @db.Text
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  deleted_at          DateTime?

  user     User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders   Order[]           @relation("AssignedOrders")
  earnings DeliveryEarning[]

  @@index([user_id])
  @@index([status])
  @@index([is_available])
  @@map("delivery_profiles")
}

model KycRecord {
  id               String    @id @default(uuid()) @db.Uuid
  user_id          String    @db.Uuid
  type             String    @db.VarChar(30) // "vendor" | "delivery"
  documents        Json?     @db.JsonB
  status           KycStatus @default(NOT_SUBMITTED)
  verified_by      String?   @db.Uuid
  verified_at      DateTime?
  rejection_reason String?   @db.Text
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, type])
  @@index([status])
  @@map("kyc_records")
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  vendor_id      String    @db.Uuid
  category_id    String    @db.Uuid
  subcategory_id String?   @db.Uuid
  name           String    @db.VarChar(160)
  slug           String    @db.VarChar(200)
  description    String?   @db.Text
  price          Decimal   @db.Decimal(10, 2)
  mrp            Decimal   @db.Decimal(10, 2)
  tax_rate       Decimal   @default(0) @db.Decimal(5, 2)
  unit           String    @db.VarChar(50)
  variants       Json?     @db.JsonB
  tag            String?   @db.VarChar(60)
  is_active      Boolean   @default(true)
  is_featured    Boolean   @default(false)
  is_vegetarian  Boolean?
  rating         Float     @default(0) @db.DoublePrecision
  review_count   Int       @default(0)
  stock          Int       @default(0)
  total_stock    Int       @default(0)
  is_available   Boolean   @default(true)
  search_vector  String?   @db.VarChar(500)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  vendor         VendorProfile      @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  category       Category           @relation(fields: [category_id], references: [id], onDelete: Restrict)
  images         ProductImage[]
  inventory      InventoryItem[]
  cart_items     CartItem[]
  wishlist_items WishlistItem[]
  order_items    OrderItem[]
  reviews        Review[]
  rating_summary Rating?
  analytics      ProductAnalytics[]
  recent_views   RecentlyViewed[]

  @@unique([vendor_id, slug])
  @@index([category_id])
  @@index([subcategory_id])
  @@index([is_active])
  @@index([is_featured])
  @@index([name])
  @@index([vendor_id, is_active])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  product_id String   @db.Uuid
  url        String   @db.VarChar(500)
  alt_text   String?  @db.VarChar(255)
  sort_order Int      @default(0)
  is_primary Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_images")
}

