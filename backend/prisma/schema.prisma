model Order {
  id                    String        @id @default(uuid()) @db.Uuid
  order_number          String        @unique @db.VarChar(40)
  user_id               String        @db.Uuid
  vendor_id             String        @db.Uuid
  delivery_partner_id   String?       @db.Uuid
  address_id            String        @db.Uuid
  coupon_id             String?       @db.Uuid
  status                OrderStatus   @default(PENDING)
  items_subtotal        Decimal       @db.Decimal(10, 2)
  delivery_fee          Decimal       @default(0) @db.Decimal(10, 2)
  discount              Decimal       @default(0) @db.Decimal(10, 2)
  tax                   Decimal       @default(0) @db.Decimal(10, 2)
  total                 Decimal       @db.Decimal(10, 2)
  payment_method        PaymentMethod @default(RAZORPAY)
  payment_status        PaymentStatus @default(PENDING)
  otp_code              String?       @db.VarChar(10)
  otp_expires_at        DateTime?
  otp_attempts          Int           @default(0)
  delivery_note         String?       @db.VarChar(500)
  invoice_number        String?       @unique @db.VarChar(40)
  delivered_at          DateTime?
  cancelled_at          DateTime?
  cancel_reason         String?       @db.VarChar(255)
  refunded_at           DateTime?
  refund_reason         String?       @db.VarChar(255)
  accepted_at           DateTime?
  prepared_at           DateTime?
  packed_at             DateTime?
  picked_up_at          DateTime?
  started_at            DateTime?
  eta_minutes           Int?
  customer_lat          Float?        @db.DoublePrecision
  customer_lng          Float?        @db.DoublePrecision
  estimated_distance_km Float?        @db.DoublePrecision
  rated_at              DateTime?
  idempotency_key       String?       @unique @db.VarChar(120)
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt
  deleted_at            DateTime?

  customer          User              @relation("CustomerOrders", fields: [user_id], references: [id], onDelete: Restrict)
  vendor            VendorProfile     @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  delivery_partner  DeliveryProfile?  @relation("AssignedOrders", fields: [delivery_partner_id], references: [id], onDelete: SetNull)
  address           Address           @relation(fields: [address_id], references: [id], onDelete: Restrict)
  coupon            Coupon?           @relation(fields: [coupon_id], references: [id], onDelete: SetNull)
  items             OrderItem[]
  events            OrderEvent[]
  coupon_usage      CouponUsage?
  payment           Payment?
  transactions      Transaction[]
  delivery_tracking DeliveryTracking?
  vendor_earnings   VendorEarning[]
  delivery_earnings DeliveryEarning[]
  reviews           Review[]

  @@index([user_id, created_at])
  @@index([vendor_id, created_at])
  @@index([delivery_partner_id, status])
  @@index([status])
  @@index([created_at])
  @@map("orders")
}

model CheckoutIdempotency {
