# ==============================================================================
# Vegamart Deployment — server/deploy configuration
# Copy to `deployment/configs/deploy.env`, review, and fill in the values.
# This file is consumed by every script in the toolkit.
# ==============================================================================

# -- Deployment identity ------------------------------------------------------
# Full HTTPS or SSH git URL of your repository (both supported automatically).
# Example HTTPS: https://github.com/you/vegamart.git
# Example SSH:   git@github.com:you/vegamart.git
GIT_REPO_URL=

# Branch to deploy (default: main)
GIT_BRANCH=main

# Public domain (no scheme). Used for Nginx, SSL, APP_URL and email links.
# Example: shop.example.com
DOMAIN=

# Optional public subdomain that serves ONLY the API, e.g. api.shop.example.com.
# When set, Nginx serves the frontend on DOMAIN and the API on API_DOMAIN, and
# VITE_API_BASE_URL becomes https://API_DOMAIN/api/v1.
# Leave empty to keep the API on the main domain under /api/* (single-domain mode).
API_DOMAIN=

# Email used by Let's Encrypt for expiry notifications.
ADMIN_EMAIL=

# -- System / service layout --------------------------------------------------
# Run as root is the simplest Hostinger VPS default. Change only if you have
# created a dedicated user AND set up passwordless sudo for it.
DEPLOY_USER=root

# Base directory for everything the toolkit manages on the server.
APP_BASE_DIR=/opt/vegamart

# Ports. The public internet only ever reaches 80/443 (Nginx). These are
# loopback ports Nginx proxies to. Do not expose them via the firewall.
API_PORT=8080
WEB_PORT=3000

# Backend PM2 cluster instances ("-1" = all cores). Web/SSR stays single.
PM2_BACKEND_INSTANCES=2

# -- PostgreSQL ---------------------------------------------------------------
DB_NAME=vegamart
DB_USER=vegamart
# Where the generated DB password is stored (0600 perms).
DB_PASSWORD_FILE=/opt/vegamart/deploy/generated-db-password.txt
# "no"  -> use Prisma's built-in client-side connection pool (recommended, robust).
# "yes" -> additionally install + configure PgBouncer (transaction pooling) on :6432.
ENABLE_PGBOUNCER=no

# -- Node.js ------------------------------------------------------------------
# LTS major to install via NodeSource. 24 = current LTS.
NODE_MAJOR=24

# -- SSL ----------------------------------------------------------------------
# Extra domains to also get a certificate for (space separated, e.g. "www.shop.example.com")
SSL_EXTRA_DOMAINS=

# -- SSH hardening (configurable; safe defaults that will NOT lock you out) ----
# "yes" disables password authentication for SSH (only key auth works).
# "no"  keeps password login enabled.
SSH_DISABLE_PASSWORD_LOGIN=no
# "yes" disables root login over SSH.
# "no"  keeps root login enabled.
SSH_DISABLE_ROOT_LOGIN=no

# -- Operations ---------------------------------------------------------------
# Retention for database backups / rotated logs (days).
RETENTION_BACKUP_DAYS=30
RETENTION_LOG_DAYS=30
# Retention for old releases (kept N latest).
RELEASE_KEEP=5

# Create a 1G swap file if the server has none.
ENABLE_SWAP=yes

# -- Backups ------------------------------------------------------------------
# Comma-separated DB name patterns are NOT supported by pg_dump; this is the
# single database we back up. Additional local files to include in --all backups:
BACKUP_EXTRA_DIRS=
