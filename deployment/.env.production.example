# ==============================================================================
# Vegamart — production environment (single source of truth)
# ==============================================================================
# 1. Copy this file to `deployment/.env.production` (on the server it is kept
#    at /opt/vegamart/.env.production, outside of the repository).
# 2. Fill in the values marked MANUAL. Everything else is pre-set or generated.
# 3. The toolkit splits this file automatically:
#      - backend section  -> backend/.env       (read by Node + Prisma at runtime)
#      - VITE_* section   -> gali-connect-main/.env.production (read at build time)
#
# Required before the first deploy (backend refuses to start without them):
#   DATABASE_URL, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET,
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
#   RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_NAME=Vegamart
APP_PORT=8080
APP_URL=https://__YOUR_DOMAIN__            # MANUAL — frontend URL, e.g. https://vegamart.in
API_VERSION=v1
CLIENT_URL=https://__YOUR_DOMAIN__         # MANUAL — frontend URL (this is the CORS-allowed origin)

# ------------------------------------------------------------------------------
# Database — local PostgreSQL on the VPS (created by setup-postgres.sh).
# If you enabled PgBouncer, use host 127.0.0.1 and port 6432 instead of 5432.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://vegamart:__DB_PASSWORD__@127.0.0.1:5432/vegamart?schema=public

# ------------------------------------------------------------------------------
# JWT — the toolkit replaces placeholder values with strong random secrets.
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=__GENERATE__
JWT_REFRESH_SECRET=__GENERATE__
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=Vegamart
JWT_AUDIENCE=Vegamart

# ------------------------------------------------------------------------------
# Cookies — secure + same-site because production runs over HTTPS on one domain.
# ------------------------------------------------------------------------------
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------------
# Account security
# ------------------------------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
EMAIL_VERIFICATION_REQUIRED=true
VERIFY_EMAIL_TOKEN_TTL_HOURS=24

# ------------------------------------------------------------------------------
# Rate limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
PAYMENT_RATE_LIMIT_WINDOW_MS=60000
PAYMENT_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_MAX=20
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=60
VENDOR_RATE_LIMIT_WINDOW_MS=60000
VENDOR_RATE_LIMIT_MAX=120

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=logs

# ------------------------------------------------------------------------------
# Redis — optional. Leave empty for an in-memory fallback.
# If you install Redis on this box: redis://127.0.0.1:6379
# ------------------------------------------------------------------------------
REDIS_URL=

# ------------------------------------------------------------------------------
# Cloudflare R2 — MANUAL (REQUIRED in production).
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# Razorpay — MANUAL (REQUIRED in production). Use a live or test key.
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=__GENERATE__

# ------------------------------------------------------------------------------
# Email (Nodemailer / SMTP) — MANUAL. Leave host empty to disable delivery.
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Vegamart <no-reply@__YOUR_DOMAIN__>

# ------------------------------------------------------------------------------
# Google OAuth — optional. Add credentials to enable "Continue with Google".
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://__YOUR_DOMAIN__/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# Swagger — keep disabled in production.
# ------------------------------------------------------------------------------
SWAGGER_ENABLED=false

# ==============================================================================
# Frontend build-time variables (VITE_*) — automatically extracted at deploy time.
# __API_DOMAIN__ resolves to configs/deploy.env → API_DOMAIN; if that is empty it
# falls back to DOMAIN (single-domain mode). __YOUR_DOMAIN__ always = DOMAIN.
# ==============================================================================
VITE_API_BASE_URL=https://__API_DOMAIN__/api/v1
VITE_APP_NAME=Vegamart
VITE_APP_ENV=production
# MANUAL — must match RAZORPAY_KEY_ID above.
VITE_RAZORPAY_KEY_ID=
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPBOX_TOKEN=
VITE_ORS_API_KEY=
